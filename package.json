{
  "name": "pi-kiro-provider",
  "version": "0.3.0-native.1",
  "private": false,
  "description": "OMO Native-hardened Pi extension provider for Kiro's AWS CodeWhisperer streaming API.",
  "type": "module",
  "main": "./index.ts",
  "exports": {
    ".": "./index.ts"
  },
  "files": [
    "index.ts",
    "src",
    "compat",
    "docs",
    "scripts",
    "tests",
    "tsconfig.json",
    "config/config.example.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck",
    "lint": "node scripts/audit-terminal.mjs",
    "test": "node scripts/run-tests.mjs",
    "test:install": "node scripts/test-install-fixture.mjs",
    "test:omo": "node scripts/test-omo-smoke.mjs",
    "check": "npm run typecheck && npm run --silent lint && npm run test && npm run build",
    "setup:native": "node scripts/patch-omo-native.mjs",
    "check:native": "node scripts/patch-omo-native.mjs --check",
    "restore:native": "node scripts/patch-omo-native.mjs --restore",
    "package:dry-run": "npm pack --dry-run",
    "prepublishOnly": "npm run check",
    "postinstall": "node scripts/postinstall.mjs"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "pi-coding-agent",
    "kiro",
    "provider",
    "ai-provider",
    "oauth",
    "codewhisperer",
    "amazon-q"
  ],
  "author": "MasuRii",
  "contributors": [
    "JangHyuck Yun"
  ],
  "license": "MIT",
  "homepage": "https://github.com/JangHyuckYun/pi-kiro-provider#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JangHyuckYun/pi-kiro-provider.git"
  },
  "bugs": {
    "url": "https://github.com/JangHyuckYun/pi-kiro-provider/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "^0.74.0 || ^0.75.0 || ^0.77.0 || ^0.78.0 || ^0.79.0 || ^0.80.0",
    "@earendil-works/pi-coding-agent": "^0.74.0 || ^0.75.0 || ^0.77.0 || ^0.78.0 || ^0.79.0 || ^0.80.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "typescript": "^6.0.3",
    "@earendil-works/pi-ai": "^0.80.3",
    "@earendil-works/pi-coding-agent": "^0.80.3"
  },
  "overrides": {
    "protobufjs": "7.6.3",
    "ws": "8.21.0"
  }
}
